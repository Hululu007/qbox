<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 切换类按钮「开 + 焦点」态：实白药丸，不再加内侧描边（第 40 轮：用户判双层表达多余，
         状态由文字变色承担——焦点+开 = 白丸上标记色字）。 -->
    <corners android:radius="16dp" />

    <solid android:color="@color/qbox_text" />

    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />

</shape>
