<?xml version="1.0" encoding="utf-8"?>
<!-- filter 副标题/chip 行底色（第 35 轮）：均匀纯色半透明，禁渐变、禁变色。
     色值推导：回退版导航带二次曲线 alpha(y)=85%×(1-(y/190)^2) 在 filter 行 1 纵向中心 y≈143dp 处
     =0.85×(1-0.566)=0.369 → 36.9% ≈ #5E；即「那条阴影铺到 filter 行高度时的等效色」。
     圆角 6dp：与全站卡片/chip 圆角语言同族，读作一条刻意的「栏」；直角会与 poster 内容形成无动机硬切。
     只垫行区域本身（由 CustomRowPresenter 挂在 chip 行 gridView 背景），不延伸到海报区或 tab 行。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#5E090A0D" />
    <corners android:radius="6dp" />
</shape>
