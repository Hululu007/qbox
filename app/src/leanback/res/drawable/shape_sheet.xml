<?xml version="1.0" encoding="utf-8"?>
<!-- 底浮式设置层背景（轨道选择等，第 41 轮修正）：实测 flat 72% 比播放菜单「黑太多」——
     菜单是 48%→72%→90% 纵向渐变，顶部（用户视线区）更透。底浮层与菜单同向（都从底部浮起），
     直接套用同一渐变逻辑：上 48% → 中 72% → 下 90% 纯黑，顶圆角 20dp、底部直角贴屏。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#7A000000"
        android:centerColor="#B8000000"
        android:endColor="#E6000000"
        android:type="linear" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
