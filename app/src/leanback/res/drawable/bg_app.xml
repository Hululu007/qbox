<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 深色渐变底：顶部微亮，底部收黑，避免整块死黑。 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#05060A"
                android:startColor="#0D0F15"
                android:type="linear" />
        </shape>
    </item>

    <!-- 左上角柔光制造体积感。色彩收敛后改为中性灰白微光（原为 #332B4A74 蓝紫光，
         是界面里「奇怪蓝色」的来源之一）。 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.18"
                android:centerY="0.02"
                android:endColor="#00000000"
                android:gradientRadius="620dp"
                android:startColor="#26FFFFFF"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
