<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 氛围底图的压暗：顶部只压 22%，把 Infuse 那种模糊海报垫底的色彩留住；
         越往下越沉，保证卡片标题和下半屏文字始终有足够对比。 -->
    <gradient
        android:angle="270"
        android:centerColor="#59090A0D"
        android:centerY="0.55"
        android:endColor="#D9090A0D"
        android:startColor="#38090A0D"
        android:type="linear" />

</shape>
