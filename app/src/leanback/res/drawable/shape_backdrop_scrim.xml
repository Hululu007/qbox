<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 氛围底图的压暗：顶部加深到 55% 并向中上部平滑过渡（渐隐入黑，消灭亮海报顶边硬切）；
         中部保留 35% 让模糊海报色彩透出来；越往下越沉，保证卡片标题和下半屏文字对比度。 -->
    <gradient
        android:angle="270"
        android:centerColor="#59090A0D"
        android:centerY="0.55"
        android:endColor="#D9090A0D"
        android:startColor="#8C090A0D"
        android:type="linear" />

</shape>
