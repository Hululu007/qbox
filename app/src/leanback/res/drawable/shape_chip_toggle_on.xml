<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 切换类按钮「开」态（非焦点）：白描边 + 15% 白底衬 + 白字。
         色彩收敛后激活态只用白/灰阶，不再用品牌蓝（B7：亮色不协调，改用白色相对色）。 -->
    <corners android:radius="16dp" />

    <solid android:color="#26FFFFFF" />

    <stroke
        android:width="1dp"
        android:color="@color/qbox_text" />

    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />

</shape>
