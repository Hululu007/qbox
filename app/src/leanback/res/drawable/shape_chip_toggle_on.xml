<?xml version="1.0" encoding="utf-8"?>
<!-- 切换类按钮「开」态（非焦点）：深蓝底衬 + accent 描边。
     与焦点态（实心白药丸）形态上明确区分：描边=状态，白底=焦点。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/qbox_accent_soft" />
    <stroke
        android:width="1dp"
        android:color="@color/qbox_accent" />
    <corners android:radius="16dp" />
    <padding
        android:bottom="8dp"
        android:left="14dp"
        android:right="14dp"
        android:top="8dp" />
</shape>
