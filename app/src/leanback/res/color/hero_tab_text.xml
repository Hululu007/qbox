<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第 37 轮文字收敛：tab 文字统一白系两档——选中=L1 白，未选=L2 #C9C9D1；
         修正旧版「选中=dim、未选=白」的反相语义（那是『字体颜色还是很多种』的来源之一）。 -->
    <item android:color="@color/qbox_focus_text" android:state_focused="true" />
    <item android:color="@color/qbox_text" android:state_selected="true" />
    <item android:color="#C9C9D1" />
</selector>
