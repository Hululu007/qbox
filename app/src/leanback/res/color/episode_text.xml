<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选集滚动名：只有 marquee 被 setSelected(true) 时才反色；不能靠 duplicateParentState，
         否则程序化 setSelected 会被父容器状态覆盖，marquee 永远不会启动。 -->
    <item android:color="@color/qbox_focus_text" android:state_selected="true" />
    <item android:color="@color/qbox_focus_text" android:state_focused="true" />
    <item android:color="@color/qbox_text" />
</selector>
