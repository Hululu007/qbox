<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/qbox_accent</item>
        <item name="colorSurface">@color/qbox_surface</item>
        <item name="colorOnSurface">@color/qbox_text</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.QBox.Dialog</item>
        <item name="android:colorBackground">@color/qbox_bg</item>
        <item name="android:windowBackground">@color/qbox_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <!-- 设置页分区标题：小字号、字距拉开、压暗，和可聚焦的行区分开。 -->
    <style name="SettingHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/qbox_text_mute</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 对话框：Material3 默认会按 elevation 给 surface 叠加一层紫灰，和纯黑界面不搭，这里关掉叠色。 -->
    <style name="ThemeOverlay.QBox.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/qbox_surface</item>
        <item name="colorSurfaceContainerHigh">@color/qbox_surface</item>
        <item name="colorSurfaceContainer">@color/qbox_surface</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="HeroTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/selector_hero_tab</item>
        <item name="android:textColor">@color/hero_tab_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 设置页统一行样式：两列布局下每条不再是一条超长空条。 -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/selector_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:ellipsize">middle</item>
        <item name="android:gravity">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
