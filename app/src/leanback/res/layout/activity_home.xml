<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 氛围底图：当前聚焦海报低分辨率放大，整屏铺满，滚动时不会露出黑底。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_backdrop_scrim" />

    <!-- 顶栏悬浮层：轻压暗渐变，避免和下方内容出现硬切线。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/shape_top_fade" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="22dp"
        android:paddingEnd="32dp"
        android:paddingBottom="2dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_hero_tab"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:letterSpacing="0.01"
            android:maxWidth="560dp"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/hero_tab_text"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="玩偶哥哥 | 4K弹幕" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.fongmi.android.tv.ui.custom.ActionChip
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            app:chipIcon="@drawable/ic_home_search"
            app:chipText="@string/home_search" />

        <com.fongmi.android.tv.ui.custom.ActionChip
            android:id="@+id/live"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            app:chipIcon="@drawable/ic_home_live"
            app:chipText="@string/home_live" />

        <com.fongmi.android.tv.ui.custom.ActionChip
            android:id="@+id/keep"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            app:chipIcon="@drawable/ic_home_keep"
            app:chipText="@string/home_keep" />

        <com.fongmi.android.tv.ui.custom.ActionChip
            android:id="@+id/push"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            app:chipIcon="@drawable/ic_home_push"
            app:chipText="@string/home_push" />

        <com.fongmi.android.tv.ui.custom.ActionChip
            android:id="@+id/setting"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            app:chipIcon="@drawable/ic_qbox_setting"
            app:chipText="@string/home_setting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="0.02"
            android:textColor="@color/qbox_text_dim"
            android:textSize="15sp"
            tools:text="09:20  10/30 周五" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 分类固定条：不跟随内容滚动，任何位置都能一眼看到当前源有哪些分类。
         高度写死，配置还没拉回来时不占位也不会让下面的内容跳一下。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp">

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/typeRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.fongmi.android.tv.ui.custom.ProgressLayout
            android:id="@+id/progressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="true"
                android:paddingStart="32dp"
                android:paddingTop="22dp"
                android:paddingEnd="32dp"
                android:paddingBottom="8dp"
                app:focusOutEnd="true"
                app:focusOutFront="true" />

        </com.fongmi.android.tv.ui.custom.ProgressLayout>

    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
