<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 氛围底图：跟随焦点海报，整屏铺满（第 28 轮统一详情页终态：BackdropBlur 氛围模糊 + alpha 0.85）。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- 第 28 轮：整屏压暗/200dp 顶栏渐变/96dp 左右渐隐全部撤掉（用户实机仍看出黑带），
         统一成详情页 D 版同款四边轻收边（上/左右 40dp@12%，底 120dp@30%）。 -->
    <View
        android:id="@+id/backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_backdrop_scrim_d" />

    <!-- 按需导航带（第 29 轮起）：静止 alpha=0 不可见；焦点进导航区时 HomeActivity 淡入。
         第 35 轮回退 31 轮二次曲线版并延域 190dp；第 37 轮拆「主体+4dp 收边」，材质=@color/qbox_panel。
         第 38 轮层级修正：放在内容层之下——栏是文字「背后」的底，不许盖住文字（同 vod 页修正）。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/nav_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:orientation="vertical">

        <View
            android:id="@+id/nav_scrim"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/shape_nav_scrim" />

        <View
            android:id="@+id/nav_scrim_edge"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/shape_nav_bar_edge"
            android:visibility="gone" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 内容层：从屏幕最顶开始，靠 paddingTop 让出头部空间。
         绘制的硬裁切线在 124dp（CustomVerticalGridView.setClipTop），
         卡片不会从分类条下面穿出来；clipToPadding=false 保证聚焦放大不被裁。 -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.fongmi.android.tv.ui.custom.CustomVerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="32dp"
            android:paddingTop="@dimen/qbox_content_top"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

    </com.fongmi.android.tv.ui.custom.ProgressLayout>

    <!-- 头部浮层：顶栏 + 分类条。位置与点播页逐 dp 相同，切页时整块框架不动。
         第 28 轮：200dp 顶栏压暗渐变撤掉（用户实机仍看出黑带），顶栏文字直接浮在氛围底图上。
         id=header：导航带显示判据用的「导航区」结构边界（第 31 轮）。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingTop="@dimen/qbox_header_pad_top"
            android:paddingEnd="32dp"
            android:paddingBottom="2dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_hero_tab"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:letterSpacing="0.01"
                android:maxWidth="560dp"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/hero_tab_text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="豆豆 | 4K蓝光" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.fongmi.android.tv.ui.custom.ActionChip
                android:id="@+id/search"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qbox_header_content"
                app:chipIcon="@drawable/ic_home_search"
                app:chipText="@string/home_search" />

            <com.fongmi.android.tv.ui.custom.ActionChip
                android:id="@+id/live"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qbox_header_content"
                android:layout_marginStart="6dp"
                app:chipIcon="@drawable/ic_home_live"
                app:chipText="@string/home_live" />

            <com.fongmi.android.tv.ui.custom.ActionChip
                android:id="@+id/keep"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qbox_header_content"
                android:layout_marginStart="6dp"
                app:chipIcon="@drawable/ic_home_keep"
                app:chipText="@string/home_keep" />

            <com.fongmi.android.tv.ui.custom.ActionChip
                android:id="@+id/push"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qbox_header_content"
                android:layout_marginStart="6dp"
                app:chipIcon="@drawable/ic_home_push"
                app:chipText="@string/home_push" />

            <com.fongmi.android.tv.ui.custom.ActionChip
                android:id="@+id/setting"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qbox_header_content"
                android:layout_marginStart="6dp"
                app:chipIcon="@drawable/ic_qbox_setting"
                app:chipText="@string/home_setting" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.02"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/white_50"
                android:textSize="14sp"
                tools:text="09:20  10/30 周三" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 分类条固定在顶栏下方，高度写死，配置没回来时也不跳。
             第 35 轮：tab 文字底衬（shape_text_bed 柔光斑）被用户判「很丑」整体移除，tab 只剩自身文字阴影。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/qbox_tabs_height"
            android:layout_marginTop="@dimen/qbox_tabs_gap">

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/typeRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:focusOutEnd="true"
                app:focusOutFront="true" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>
