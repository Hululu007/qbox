<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 氛围底图：跟随当前聚焦海报，整屏铺满。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.62"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_backdrop_scrim" />

    <!-- 内容层：pager 从屏幕最顶开始，分类页里的列表再让出 paddingTop。
         和首页完全同一套尺寸，点进来时上方模块不会缩进/上移。 -->
    <com.fongmi.android.tv.ui.custom.CustomViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏压暗：40% → 0，和首页同一套尺寸，模糊海报底图从顶栏后面透出来。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/qbox_header_mask"
        android:background="@drawable/shape_top_scrim" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingTop="@dimen/qbox_header_pad_top"
            android:paddingEnd="32dp"
            android:paddingBottom="2dp">

            <!-- 46dp 点击区，标题左边与首页源名对齐到 96dp。 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back"
                android:layout_width="@dimen/qbox_header_content"
                android:layout_height="@dimen/qbox_header_content"
                android:background="@drawable/selector_action_icon"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:singleLine="true"
                android:textColor="@color/qbox_text"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="电影" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_filter_chip"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:letterSpacing="0.02"
                android:paddingStart="13dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="@string/filter"
                android:textColor="@color/hero_tab_text"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/ic_filter"
                app:drawableTint="@color/hero_tab_text"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.02"
                android:textColor="@color/qbox_text_dim"
                android:textSize="15sp"
                tools:text="09:20:00" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/qbox_tabs_height"
            android:layout_marginTop="@dimen/qbox_tabs_gap">

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/typeRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                app:focusOutEnd="false"
                app:focusOutFront="false" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
