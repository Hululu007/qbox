<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 焦点/点击都在本 view 上，不能用 duplicateParentState——否则背景取父节点（永不聚焦）的状态，
         焦点白 pill 与选中底永远画不出来（A3「配置对话框无焦点可见」的根因之一）。 -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:background="@drawable/selector_chip_round"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="18sp"
        tools:text="https://fongmi.github.io/live.json" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/pass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/selector_chip_round"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_live_pass"
        app:tint="@color/text" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/boot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/selector_chip_round"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_live_boot"
        app:tint="@color/text" />

</androidx.appcompat.widget.LinearLayoutCompat>