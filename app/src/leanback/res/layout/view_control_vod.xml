<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/shape_controller"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <!-- 名称行：标题（weight=1，超长省略）+ 右侧源质量小标签。
         标签行高由 18sp 标题决定，12sp 标签的出现/消失不改变行高，不推挤标题与秒数。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="18sp"
            tools:text="杯雪·一战成名：正片" />

        <!-- 源质量胶囊行（第 26 轮）：视频一枚、音频一枚，分组可分；缺哪类哪枚 GONE，不凑占位。
             胶囊为不可点信息标签（与可点按钮的胶囊化禁令不冲突，见 GS-47/汇报区分说明）。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/track_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/track_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_track_chip"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/qbox_text_dim"
                android:textSize="11sp"
                tools:text="1080p · H.265 · HDR10" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/track_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_track_chip"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/qbox_text_dim"
                android:textSize="11sp"
                tools:text="DD+ · 5.1" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- 进度条焦点框：遥控器按「上」可以进到这里，左右逐 10s 拖拽。
         PlayerSeekView 自己不拿焦点（播放器 buffering 时会丢焦点），焦点固定在外层。 -->
    <FrameLayout
        android:id="@+id/seek_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/selector_seek_focus"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <androidx.media3.ui.PlayerSeekView
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false" />

    </FrameLayout>

    <include
        android:id="@+id/action"
        layout="@layout/view_control_vod_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</androidx.appcompat.widget.LinearLayoutCompat>
